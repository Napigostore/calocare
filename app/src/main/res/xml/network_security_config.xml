<?xml version="1.0" encoding="utf-8"?>
<!-- Only encrypted connections; the system's trusted certificate authorities are the only ones accepted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
