<?xml version="1.0" encoding="utf-8"?>
<!-- Diary, profile and AI key never leave the device through cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
